<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>limo_mission</name>
  <version>0.0.0</version>
  <description>Mission orchestration + docking for LIMO (Nav2 + LiDAR)</description>

  <maintainer email="igordacosta.sl010@gmail.com">solverbot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Python runtime -->
  <depend>rclpy</depend>

  <!-- Messages used -->
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- Nav2 action used by the mission navigator -->
  <depend>nav2_msgs</depend>

  <!-- Dock action interface lives in limo_mission_msgs -->
  <depend>limo_mission_msgs</depend>

  <!-- Docking geometry uses numpy -->
  <exec_depend>python3-numpy</exec_depend>

  <!-- Tests -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
